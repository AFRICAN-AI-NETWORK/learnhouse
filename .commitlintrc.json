version: 3.5.0-rc.1
plugins:
  '@commitlint/config-conventional': enabled
extends:
  - '@commitlint/config-conventional'
rules:
  type-enum:
    - 2
    - always
    - - feat
      - fix
      - docs
      - style
      - refactor
      - perf
      - test
      - build
      - ci
      - chore
      - revert
      - security
  subject-max-length:
    - 2
    - always
    - 100
  footer-max-line-length:
    - 1
    - always
    - Infinity
