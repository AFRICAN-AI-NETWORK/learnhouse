{
  "expo": {
    "name": "AINA",
    "slug": "learnhouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aina-logo-icon.png",
    "scheme": "aina",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.africanainetwork.aina"
    },
    "android": {
      "package": "com.africanainetwork.aina",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/aina-logo-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a0caf82-7687-4786-87fc-371a881328fc"
      }
    }
  }
}
