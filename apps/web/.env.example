# Flutterwave Configuration
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=your_flutterwave_public_key_here
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key_here
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_hash_here

# ─────────────────────────────────────────────────────────────────────────────
# Offline / PWA Configuration
#
# These MUST keep the NEXT_PUBLIC_ prefix: they are read in the browser via
# getConfig() (window.__RUNTIME_CONFIG__ -> runtime-config.json -> process.env).
# Without the prefix they are undefined at runtime.
#
# The service worker cannot read runtime config at all and uses the defaults
# compiled into lib/offline/constants.ts.
# ─────────────────────────────────────────────────────────────────────────────

# Master switches. Both default to false, so the offline subsystem ships dark and
# the app behaves exactly as it does today until these are turned on.
NEXT_PUBLIC_OFFLINE_READ_ENABLED=false
NEXT_PUBLIC_OFFLINE_WRITE_ENABLED=false

# Maximum local storage budget in megabytes. Applies to IndexedDB + Cache Storage
# combined. Defaults to 200 (or 500 when the browser grants persistent storage).
NEXT_PUBLIC_OFFLINE_CACHE_MAX_MB=200

# How long a cached session may gate offline reads after the access token expires.
# Read-only by definition: a grace session never authorises a write.
NEXT_PUBLIC_OFFLINE_GRACE_PERIOD_HOURS=72

# Whether self-hosted video files may be cached. Off by default because video is
# large. YouTube-hosted video is never cached (their terms prohibit it).
NEXT_PUBLIC_OFFLINE_ENABLE_VIDEO_CACHE=false

# Outbox replay attempts before a queued write is marked FAILED and surfaced.
NEXT_PUBLIC_OFFLINE_SYNC_RETRY_MAX=5

# Set to true to skip service worker generation entirely (already honoured).
# DISABLE_PWA=false
